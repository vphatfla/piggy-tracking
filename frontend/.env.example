# Base URL of the backend API (the backend runs in docker-compose on port 3000).
# Copy to .env.local to override.
#
# Production build (vphatfla.me/app/piggy-tracking/): set this to an empty
# string instead. api.ts does `${VITE_API_URL}${path}` where every `path`
# already starts with `/api/...`, so an empty base makes every request
# resolve relative to whatever origin served the page — vphatfla.me/api/...
# automatically, same-origin, no domain hardcoded into the build. See
# terraform/README.md for how /api/* gets routed there.
VITE_API_URL=http://localhost:3000

# Google OAuth *Web application* client ID. Must be the same value as the
# backend's GOOGLE_CLIENT_ID — the backend rejects ID tokens minted for any
# other audience. Add http://localhost:5173 as an authorised JavaScript origin.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
