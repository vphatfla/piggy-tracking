// Prisma schema — https://pris.ly/d/prisma-schema
// Datasource URL is supplied by prisma7.config.ts from the DATABASE_URL env var.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// An application user. Authentication is Google OAuth only, so there is no
/// password column — `googleId` holds the `sub` claim from the Google ID token.
model User {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String   @unique
  googleId    String   @unique
  phoneNumber String?
  location    String?
  yearOfBirth Int?     @db.SmallInt
  createdAt   DateTime @default(now())

  receipts      Receipt[]
  transactions  Transaction[]
  categories    Category[]
  budgets       Budget[]
  refreshTokens RefreshToken[]
}

/// A scanned/uploaded receipt. Deleting the owning user removes their receipts.
model Receipt {
  id              Int      @id @default(autoincrement())
  userId          Int
  date            DateTime @db.Date
  totalAmount     Decimal  @db.Decimal(10, 2)
  receiptFileName String?
  createdAt       DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

/// A single line of spending. A transaction may stand alone (manually entered)
/// or belong to a receipt; deleting that receipt detaches the transaction
/// (receiptId -> NULL) rather than deleting it.
model Transaction {
  id           Int      @id @default(autoincrement())
  userId       Int
  receiptId    Int?
  /// When the money was spent, as a calendar DATE — deliberately not
  /// `createdAt`, which is only when the row was entered. A budget period is a
  /// calendar month, so a date with no timezone is the only way "which month is
  /// this in" has a single answer.
  date         DateTime @db.Date
  merchantName String
  amount       Decimal  @db.Decimal(10, 2)
  /// Nullable in the database but required by the API on create: "every
  /// transaction is categorised" is a creation-time rule, while storage has to
  /// permit NULL so deleting a category cannot delete the spending. A NULL here
  /// means exactly one thing — the category this belonged to was deleted.
  categoryId   Int?
  createdAt    DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipt  Receipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([receiptId])
  @@index([userId, date])
  @@index([categoryId])
}

/// A user-owned spending category. Scoped per user, so two people naming the
/// same thing differently never have to be reconciled — nothing in this app
/// reads across users.
///
/// Deliberately carries no `budget` column. A single limit per category would
/// be retroactive: raising the groceries cap in June would silently re-score
/// January as under budget. Limits are per-month rows in a separate `Budget`
/// table — see docs/budgets.md.
model Category {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name])
  @@index([userId])
}

/// A spending limit for one category in one month. Rows are sparse and
/// *inherit forward*: the limit in effect for month M is the row with the
/// greatest `month <= M`, so a past month keeps the number it was actually
/// judged against instead of being re-scored when the user changes their mind.
/// That is the whole reason this is a table and not a `budget` column on
/// Category. See docs/budgets.md.
///
/// Two things here are load-bearing:
/// - `categoryId` is NOT NULL and must stay that way. A nullable one meaning
///   "the overall budget" looks tempting, but Postgres treats NULLs as distinct
///   in a unique index, so @@unique would accept two overall budgets for the
///   same month and enforce nothing.
/// - `month` is VARCHAR(7) ("2026-09"), not a DATE: it sorts lexicographically
///   and compares with <= exactly as the inheritance lookup needs, and carries
///   no timezone to convert wrongly.
model Budget {
  id         Int      @id @default(autoincrement())
  userId     Int
  categoryId Int
  month      String   @db.VarChar(7)
  amount     Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Cascade, unlike Transaction's SetNull: money spent stays true without its
  /// label, but a limit for a category that no longer exists is meaningless.
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
  @@index([userId, month])
}

/// A refresh-token handle for one browser session. The raw token is only ever
/// sent to the client in the httpOnly cookie — what is stored here is its
/// SHA-256 hash, so a database leak cannot be replayed as a login.
/// Rotation on every use means a row is short-lived: `revokedAt` is stamped and
/// a replacement row is inserted. A non-null `revokedAt` is never valid again.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
