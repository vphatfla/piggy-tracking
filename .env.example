# Copy to .env before running `docker compose up`:  cp .env.example .env
# .env is gitignored; this file is the committed template.

# --- Postgres ---
POSTGRES_USER=piggy
POSTGRES_PASSWORD=piggy_dev_password
POSTGRES_DB=piggy
# Host port mapped to Postgres' 5432 inside the container.
POSTGRES_PORT=5432

# --- Backend ---
# Host port mapped to the backend's 3000 inside the container.
BACKEND_PORT=3000
# Origin(s) allowed to call the API from a browser. The Vite dev server
# defaults to 5173. Comma-separate for multiple origins.
CORS_ORIGIN=http://localhost:5173

# --- Running Prisma commands from your host (outside Docker) ---
# The backend container builds its own DATABASE_URL from the values above using
# the `db` hostname. This one uses localhost, for `npx prisma ...` on your machine.
DATABASE_URL=postgresql://piggy:piggy_dev_password@localhost:5432/piggy?schema=public

# --- Auth (Google OAuth + JWT sessions) ---
# OAuth 2.0 *Web application* client ID from https://console.cloud.google.com/apis/credentials
# with http://localhost:5173 as an authorised JavaScript origin. The backend
# verifies that ID tokens were issued for this exact client.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Two independent secrets: a leaked access-token secret must not also mint
# refresh tokens. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
# Short — the refresh cookie is what keeps a session alive, and the frontend
# renews the access token by itself on a 401, so nobody sees this expire.
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=30
